class DataLoader:
    def __init__(self, file_2017, file_2024):
        self.file_2017 = Path(file_2017)
        self.file_2024 = Path(file_2024)
        self.data = {}
        self.metadata = {}

    def load(self):
        print("=" * 80)
        print("LOADING DATA")
        print("=" * 80)

        if not self.file_2017.exists():
            raise FileNotFoundError(f"File not found: {self.file_2017}")
        print(f"  Loading: {self.file_2017}")
        with rasterio.open(self.file_2017) as src:
            data_2017 = src.read(1)
            self.metadata = {
                "transform": src.transform,
                "crs": src.crs,
                "shape": data_2017.shape,
                "nodata": src.nodata,
            }
            valid_2017 = ~(
                np.isnan(data_2017) | np.isinf(data_2017) |
                (data_2017 < -1e10) | (data_2017 > 1e10) |
                (data_2017 == -9999) | (data_2017 == -32767) |
                ((data_2017 == src.nodata) if src.nodata is not None else False)
            )
            urban_2017 = (data_2017 == 1).astype(np.uint8)
            self.data[2017] = {"raw": data_2017, "urban": urban_2017, "valid_mask": valid_2017.astype(np.uint8)}
            print(f"  ✓ 2017: {np.sum(urban_2017):,} urban pixels")

        if not self.file_2024.exists():
            raise FileNotFoundError(f"File not found: {self.file_2024}")
        print(f"  Loading: {self.file_2024}")
        with rasterio.open(self.file_2024) as src:
            data_2024 = src.read(1)
            valid_2024 = ~(
                np.isnan(data_2024) | np.isinf(data_2024) |
                (data_2024 < -1e10) | (data_2024 > 1e10) |
                (data_2024 == -9999) | (data_2024 == -32767) |
                ((data_2024 == src.nodata) if src.nodata is not None else False)
            )
            urban_2024 = (data_2024 == 1).astype(np.uint8)
            self.data[2024] = {"raw": data_2024, "urban": urban_2024, "valid_mask": valid_2024.astype(np.uint8)}
            print(f"  ✓ 2024: {np.sum(urban_2024):,} urban pixels")

        print("\n✓ Data loaded successfully\n")
        return self.data, self.metadata



def analyze_urban_sprawl_interval(data, metadata, exporter, fig_gen, interval_name, year_t0, year_t1):
    print("\n" + "=" * 80)
    print(f"ANALYZING URBAN SPRAWL: {interval_name}")
    print("=" * 80)

    urban_t0 = data[year_t0]["urban"]
    urban_t1 = data[year_t1]["urban"]
    valid_mask = (data[year_t0]["valid_mask"] & data[year_t1]["valid_mask"]).astype(np.uint8)

    new_urban = (urban_t1 == 1) & (urban_t0 == 0) & (valid_mask > 0)
    old_urban = (urban_t0 == 1) & (valid_mask > 0)

    print("\n   Urban areas:")
    print(f"     Pre-existing ({year_t0}): {np.sum(old_urban):,} pixels")
    print(f"     New growth ({year_t0}-{year_t1}): {np.sum(new_urban):,} pixels")
    print(f"     Total urban ({year_t1}): {np.sum(urban_t1):,} pixels")

    if np.sum(new_urban) < 10:
        print("   ⚠ Insufficient new urban growth for analysis")
        return None

    param_learner = ParameterLearner()
    params = param_learner.learn_parameters(new_urban, urban_t0, valid_mask)
    if params is None:
        print("   ⚠ Could not learn parameters")
        return None

    valid_pixel_count = int(np.sum(valid_mask > 0))
    valid_area_m2 = valid_pixel_count * Config.PIXEL_AREA_M2
    print(f"   Valid study area (pixels): {valid_pixel_count:,}")
    print(f"   Valid study area (m²): {valid_area_m2:,.0f}")

    results = {}

    # 1. Ripley's K/L
    ripley_calc = RipleysKCalculator(params)
    results["ripley"] = ripley_calc.calculate(new_urban, valid_mask, valid_area_m2)

    # 2. Moran's I
    moran_calc = MoransICalculator(params)
    results["moran"] = moran_calc.calculate(new_urban, valid_mask)

    # 3. NNI
    nni_calc = NearestNeighborCalculator()
    if results["ripley"] is not None and "centroids" in results["ripley"]:
        results["nni"] = nni_calc.calculate(
            results["ripley"]["centroids"], valid_mask, valid_area_m2
        )
    else:
        results["nni"] = None

    # 4. Quadrat VMR
    vmr_calc = QuadratAnalysisCalculator(params)
    results["vmr"] = vmr_calc.calculate(new_urban, valid_mask)

    # 5. Integrate (pure CDF, no range expansion)
    integrator = DispersionIntegrator()
    results["integration"] = integrator.integrate(
        results["ripley"], results["moran"], results["nni"], results["vmr"]
    )

    # 6. Spatial raster & export
    if results["integration"] is not None:
        raster_gen = SpatialRasterGenerator()
        centroids = results["ripley"]["centroids"] if results["ripley"] is not None else None
        sd_raster = raster_gen.generate_sprawl_raster(
            new_urban_mask=new_urban,
            old_urban_mask=old_urban,
            dispersion_global=results["integration"]["dispersion"],
            centroids=centroids,
            params=params,
        )

        raster_filename = f"urban_sprawl_dispersion_{interval_name.replace('-', '_')}.tif"
        exporter.export_raster(sd_raster, raster_filename)
        exporter.export_report(interval_name, results, params)
        fig_gen.generate_all_figures(
            interval_name,
            results["ripley"], results["moran"],
            results["nni"], results["vmr"],
            results["integration"], params,
        )

        return {
            "raster": sd_raster,
            "dispersion": results["integration"]["dispersion"],
            "results": results,
        }
    return None


def main():
    np.random.seed(42)

    output_dir = Path(OUTPUT_DIRECTORY)
